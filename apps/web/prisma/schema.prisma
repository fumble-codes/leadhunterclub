datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                     String    @id // Clerk User ID (e.g., user_2d...)
  email                  String    @unique
  name                   String
  role                   String    @default("user")
  credits                Int       @default(200) // current available credits
  emailVerified          DateTime? // Synced from Clerk
  
  // Subscription management (Stripe integration ready)
  plan                   String    @default("FREE") // "FREE", "PRO", "ENTERPRISE"
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  leadStates             UserLeadState[]
}

model Lead {
  id               String          @id @default(uuid())
  name             String
  email            String
  phone            String?
  company          String
  source           String
  category         String
  title            String
  signalContext    String
  role             String
  taskScope        String
  mustHave         String
  nicheBonus       String
  buyerType        String
  urgency          String          // "low", "medium", "high", "critical"
  winProb          String          // "low", "medium", "high"
  nicheTags        String[]
  niches           String[]
  hashtags         String[]
  replyProbability Int
  accent           String          // "mint", "purple", "cyan", "orange", "pink"
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  userStates       UserLeadState[]
}

model UserLeadState {
  id             String    @id @default(uuid())
  userId         String
  leadId         String
  isSaved        Boolean   @default(false)
  isRevealed     Boolean   @default(false)
  status         String    @default("new") // 'new' | 'saved' | 'drafting' | 'sent' | 'replied' | 'follow-up'
  revealedAt     DateTime?
  lastActionDate DateTime? @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  emails         EmailMessage[]

  @@unique([userId, leadId])
}

model EmailMessage {
  id              String        @id @default(uuid())
  userLeadStateId String
  subject         String
  body            String
  direction       String        // "outbound" | "inbound"
  sentAt          DateTime      @default(now())

  userLeadState   UserLeadState @relation(fields: [userLeadStateId], references: [id], onDelete: Cascade)
}

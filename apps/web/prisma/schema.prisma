datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                     String    @id // Firebase Auth UID
  email                  String    @unique
  name                   String
  phone                  String?
  role                   String    @default("user")
  emailVerified          DateTime?

  // User status for approval workflow
  status                 String    @default("PENDING") // "PENDING" | "ACTIVE" | "REJECTED" | "SUSPENDED"

  // Onboarding information
  portfolio              String?
  website                String?
  linkedin               String?
  instagram              String?
  dribbble               String?
  behance                String?
  github                 String?
  twitter                String?
  servicesOffered        String[] @default([])
  preferredLeadCategories String[] @default([])
  outreachExperience     String?
  discoverySource        String?

  // Subscription management (Stripe → Razorpay migration future)
  plan                   String    @default("FREE")
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  googleSheetId          String?
  creditAccount          CreditAccount?
  leadStates             UserLeadState[]
  auditLogs              AuditLog[]
  adminNotes             AdminNote[]
}

model CreditAccount {
  id                 String   @id @default(uuid())
  userId             String   @unique
  subscriptionBalance Int     @default(0)
  bonusBalance       Int      @default(0)
  renewalDate        DateTime?

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("credit_accounts")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   // Target user being acted upon
  adminId    String   // Admin who performed the action
  action     String   // 'STATUS_CHANGE' | 'CREDIT_CHANGE' | etc.
  targetType String   // 'USER', 'LEAD', etc.
  targetId   String   // Entity ID
  details    Json     @default("{}")
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Lead {
  id               String          @id @default(uuid())
  name             String
  email            String
  phone            String?
  company          String
  source           String
  category         String
  title            String
  signalContext    String
  role             String
  taskScope        String
  mustHave         String
  nicheBonus       String
  buyerType        String
  urgency          String
  winProb          String
  nicheTags        String[]
  niches           String[]
  hashtags         String[]
  replyProbability Int
  accent           String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  userStates       UserLeadState[]
}

model UserLeadState {
  id             String    @id @default(uuid())
  userId         String
  leadId         String
  isSaved        Boolean   @default(false)
  isRevealed     Boolean   @default(false)
  status         String    @default("new")
  revealedAt     DateTime?
  lastActionDate DateTime? @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  emails         EmailMessage[]

  @@unique([userId, leadId])
}

model EmailMessage {
  id              String        @id @default(uuid())
  userLeadStateId String
  subject         String
  body            String
  direction       String
  sentAt          DateTime      @default(now())

  userLeadState   UserLeadState @relation(fields: [userLeadStateId], references: [id], onDelete: Cascade)
}

model AdminNote {
  id        String   @id @default(uuid())
  userId    String
  adminId   String
  content   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_notes")
}

model CrmNote {
  id        String   @id @default(uuid())
  userId    String
  leadId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CrmActivity {
  id        String   @id @default(uuid())
  userId    String
  leadId    String
  action    String
  details   String?
  createdAt DateTime @default(now())
}
